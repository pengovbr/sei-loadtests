              <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">
def montar(size){

	char[] alphabeto = &quot;abcdefghijklmnopqrstuvwxyz0123456789&quot;.toCharArray();

	StringBuilder sb = new StringBuilder(size);

     Random random = new Random();

     for (int i = 0; i &lt; size; i++) {     
         char c = alphabeto[random.nextInt(alphabeto.length)];     
         sb.append(c);
     }

     return sb.toString()
}



def montar_texto_aleatorio(size){

    r=&quot;&quot;
    for (i=0; i&lt;size; i++){
        p1 = montar(3)
        p2 = montar(2)
        p3 = montar(5)
        p4 = montar(4)
        p5 = montar(6)

        r += &quot;&lt;p&gt;${p1} ${p2} ${p3} ${p4} ${p5}&lt;/p&gt;&quot;
    }
    

    return r

}

secao_3_texto = vars.get(&quot;secao_3_texto&quot;)


sequencia_20 = montar(7)
sequencia_2 = montar(2)
sequencia_10 = montar(20)

sequencia_pesquisa = sequencia_20 + &quot; &quot; + sequencia_2 + &quot; &quot; + sequencia_10

vars.put(&quot;sequencia_pesquisa&quot;, sequencia_pesquisa)
vars.put(&quot;secao_3_texto&quot;, secao_3_texto + sequencia_pesquisa )

</stringProp>
              </JSR223Sampler>
