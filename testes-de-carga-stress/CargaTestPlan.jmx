                  <stringProp name="parameters"></stringProp>
                  <stringProp name="script">qtdDocs = vars.get(&quot;cadProcQtdDocs&quot;)
nomedoc = vars.get(&quot;nome_documento&quot;)
pesquisar = vars.get(&quot;sequencia_pesquisa&quot;)


if(! qtdDocs){

    qtdDocs = 1

}else{

    qtdDocs = qtdDocs.toInteger()
    qtdDocs++
}

qtdDocs = qtdDocs + &quot;&quot;
vars.put(&quot;cadProcQtdDocs&quot;, qtdDocs)
vars.put(&quot;cadProc_DI_&quot; + qtdDocs, nomedoc)
vars.put(&quot;cadProc_DI_&quot; + qtdDocs + &quot;_pesquisar&quot;, pesquisar)

//log.info(vars.get(&quot;cadProcQtdDocs&quot;))
//log.info(vars.get(&quot;cadProc_DI_&quot; + qtdDocs))
//log.info(vars.get(&quot;cadProc_DI_&quot; + qtdDocs + &quot;_pesquisar&quot;))</stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
                </JSR223PostProcessor>
