          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Preparacao" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">Random rand = new Random();

qtdUnidades = &quot;${qtdUnidadesInicial}&quot;.toInteger()

unidade = rand.nextInt(qtdUnidades)+1

//define user
int v
user = []
v = (unidade * 20) - 19
user[0] = &quot;usuario&quot; + v.toString().padLeft(5, &quot;0&quot;)
v = (unidade * 20) - 18
user[1] = &quot;usuario&quot; + v.toString().padLeft(5, &quot;0&quot;)

usuario = user.get(rand.nextInt(user.size()))


vars.put(&quot;usuariosigla&quot;, usuario)</stringProp>
