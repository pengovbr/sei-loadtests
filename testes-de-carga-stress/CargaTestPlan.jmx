        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="SalvarListaProcesso" enabled="true"/>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Script Salvar Arquivo Processo" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import org.apache.jmeter.services.FileServer; 


id_proc = vars.get(&quot;id_procedimento&quot;)
proc_formatado = vars.get(&quot;procedimento_formatado&quot;)
usuario_logado = vars.get(&quot;user.login&quot;)


u = usuario_logado.replace(&quot;usuario&quot;, &quot;&quot;).toInteger()
int u = (u / 20) + 1

unidade = u.toString().padLeft(5, &quot;0&quot;)
unidade = &quot;unidade&quot; + unidade


basedir = FileServer.getFileServer().getBaseDir();

nomearquivo = basedir + &quot;/${dirCadProc}/&quot; + unidade + &quot;_proc_&quot; + id_proc

vars.put(&quot;cadProcArquivoControleNome&quot;, nomearquivo)

def f = new File( nomearquivo )
f.delete()
f.createNewFile() 

f.append(&quot;ProcedimentoFormatado=&quot; + proc_formatado + &quot;\n&quot;)


//documentos

totalDocs = vars.get(&quot;cadProcQtdDocs&quot;)
if(! totalDocs){
    totalDocs = &quot;0&quot;
}
totalDocs = totalDocs.toInteger()

for (i=1; i&lt;= totalDocs; i++){

    	docnome = vars.get(&quot;cadProc_DI_&quot; + i)
   	docpesquisa = vars.get(&quot;cadProc_DI_&quot; + i + &quot;_pesquisar&quot;)

    	f.append(&quot;DocumentoInterno_&quot; + i + &quot;=&quot; + docnome + &quot;\n&quot;)
    	f.append(&quot;DocumentoInternoPesquisa_&quot; + i + &quot;=&quot; + docpesquisa + &quot;\n&quot;)
    	
}

vars.put(&quot;cadProcQtdDocs&quot;, &quot;0&quot;)

</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Docs Externos" enabled="true">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <stringProp name="LoopController.loops">${CadProc_qtdDocsExternos}</stringProp>
        </LoopController>
        <hashTree>
          <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="Transaction Criar Doc Externo" enabled="true">
            <boolProp name="TransactionController.parent">true</boolProp>
            <boolProp name="TransactionController.includeTimers">false</boolProp>
          </TransactionController>
          <hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import org.apache.jmeter.services.FileServer
import java.security.MessageDigest

// Generate md5 hash as a 32 char String for &apos;obj&apos;
// &apos;obj&apos; can be a File, InputStream or URL
/*
def md5( obj ) {
def hash = MessageDigest.getInstance( &apos;MD5&apos; ).with {
    obj.eachByte( 8192 ) { bfr, num -&gt;
    update bfr, 0, num
    }
   it.digest()
    }
    new BigInteger( 1, hash ).toString( 16 ).padLeft( 32, &apos;0&apos; )
}
*/

Random r = new Random()
basedir = FileServer.getFileServer().getBaseDir();

dirUploads = basedir + &quot;/${dirUploadFiles}&quot; 
d = new File(dirUploads)
files = d.listFiles();
files = files.findAll{ it.getName().endsWith(&quot;.pdf&quot;) }

if (files){
	
	f = files[r.nextInt(files.size())];
	//md5 = md5(f)
	//vars.put(&quot;upload_md5&quot;, md5)
	
} 

nome = f.getName()

vars.put(&quot;upload_file_name&quot;, basedir + &quot;/${dirUploadFiles}/&quot; + nome)




n = r.nextInt(999999)

vars.put(&quot;upload_cnt&quot;, &quot;0&quot;)
vars.put(&quot;upload_identifier&quot;, n + &quot;&quot;)




</stringProp>
            </JSR223Sampler>
