              <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">
def montar(size){

	char[] alphabeto = &quot;abcdefghijklmnopqrstuvwxyz0123456789&quot;.toCharArray();

	StringBuilder sb = new StringBuilder(size);

     Random random = new Random();

     for (int i = 0; i &lt; size; i++) {     
         char c = alphabeto[random.nextInt(alphabeto.length)];     
         sb.append(c);
     }

     return sb.toString()
}



def montar_texto_aleatorio(size){

    r=&quot;&quot;
    for (i=0; i&lt;size; i++){
        p1 = montar(3)
        p2 = montar(2)
        p3 = montar(5)
        p4 = montar(4)
        p5 = montar(6)

        r += &quot;&lt;p&gt;${p1} ${p2} ${p3} ${p4} ${p5}&lt;/p&gt;&quot;
    }
    

    return r

}


sequencia_20 = montar(20)
sequencia_2 = montar(2)
sequencia_10 = montar(10)

sequencia_pesquisa = sequencia_20 + &quot; &quot; + sequencia_2 + &quot; &quot; + sequencia_10

sequencia_inicial = montar_texto_aleatorio(10)
sequencia_final = montar_texto_aleatorio(10)


secao_1_nome = vars.get(&quot;txaEditors_2&quot;)
secao_2_nome = vars.get(&quot;txaEditors_4&quot;)
secao_3_nome = vars.get(&quot;txaEditors_6&quot;)
secao_4_nome = vars.get(&quot;txaEditors_8&quot;)

secao_1_texto = vars.get(&quot;txaEditors_1&quot;)
secao_2_texto = vars.get(&quot;txaEditors_3&quot;)

vars.put(&quot;secao_1_nome&quot;, secao_1_nome)
vars.put(&quot;secao_2_nome&quot;, secao_2_nome)
vars.put(&quot;secao_3_nome&quot;, secao_3_nome)
vars.put(&quot;secao_4_nome&quot;, secao_4_nome)

vars.put(&quot;secao_1_texto&quot;, secao_1_texto)
vars.put(&quot;secao_2_texto&quot;, secao_2_texto)
//vars.put(&quot;secao_5_nome&quot;, secao_5_nome)
//log.info(&quot;aaaaaaaaac&quot;)

vars.put(&quot;sequencia_pesquisa&quot;, sequencia_pesquisa)
vars.put(&quot;secao_3_texto&quot;, sequencia_inicial + sequencia_pesquisa + sequencia_final)

</stringProp>
              </JSR223Sampler>
