      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Cenário002-Pesquisar na Unidade">
        <stringProp name="ThreadGroup.num_threads">${qtdUsers_002}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${rampup_002}</stringProp>
