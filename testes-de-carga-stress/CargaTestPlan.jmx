              <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">qtdDocsExternos = vars.get(&quot;cadProcQtdDocsExternos&quot;)
nomedoc = vars.get(&quot;nome_documento&quot;)
pesquisar = &quot;&quot;


if(! qtdDocsExternos ){

    qtdDocsExternos = 1

}else{

    qtdDocsExternos = qtdDocsExternos.toInteger()
    qtdDocsExternos++
}

qtdDocsExternos = qtdDocsExternos + &quot;&quot;
vars.put(&quot;cadProcQtdDocsExternos&quot;, qtdDocsExternos)
vars.put(&quot;cadProc_DE_&quot; + qtdDocsExternos, nomedoc)
vars.put(&quot;cadProc_DE_&quot; + qtdDocsExternos + &quot;_pesquisar&quot;, pesquisar)

//log.info(vars.get(&quot;cadProcQtdDocsExternos&quot;))
//log.info(vars.get(&quot;cadProc_DE_&quot; + qtdDocsExternos))
//log.info(vars.get(&quot;cadProc_DE_&quot; + qtdDocsExternos + &quot;_pesquisar&quot;))</stringProp>
              </JSR223Sampler>
