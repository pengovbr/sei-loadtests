            </hashTree>
          </hashTree>
        </hashTree>
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Script SalvarListaProcessoDocExterno" enabled="true"/>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Salvar Arquivo Processo" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import org.apache.jmeter.services.FileServer; 


nomearquivo = vars.get(&quot;cadProcArquivoControleNome&quot;)

def f = new File(nomearquivo)

//documentos

totalDocs = vars.get(&quot;CadProc_qtdDocsExternos&quot;)
if(! totalDocs){
    totalDocs = &quot;0&quot;
}
totalDocs = totalDocs.toInteger()

for (i=1; i&lt;=totalDocs; i++){

    	docnome = vars.get(&quot;cadProc_DE_&quot; + i)
   	docpesquisa = vars.get(&quot;cadProc_DE_&quot; + i + &quot;_pesquisar&quot;)

    	f.append(&quot;DocumentoExterno_&quot; + i + &quot;=&quot; + docnome + &quot;\n&quot;)
    	f.append(&quot;DocumentoExternoPesquisa_&quot; + i + &quot;=&quot; + docpesquisa + &quot;\n&quot;)
    	
}

vars.put(&quot;cadProcQtdDocsExterno&quot;, &quot;0&quot;)

</stringProp>
          </JSR223Sampler>
