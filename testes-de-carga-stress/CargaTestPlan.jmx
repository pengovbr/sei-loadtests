      <hashTree>
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Preparacao"/>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Preparacao">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
import org.apache.jmeter.services.FileServer; 

basedir = FileServer.getFileServer().getBaseDir();

dirProtocolos = basedir + &quot;/${dirCadProc}&quot;
d = new File(dirProtocolos)
files = d.listFiles();
files = files.findAll{ it.getName().startsWith(&quot;unidade&quot;) }

q = files.size()
while(q==0){
	
	log.info(&quot;Esperando cair arquivos no dir de processos para pesquisar&quot;)
	log.info(&quot;Vamos esperar 30 segs para verificar se ha protocolos a serem pesquisados&quot;)
	Thread.sleep(30000)
	
    dirProtocolos = basedir + &quot;/${dirCadProc}&quot;
    d = new File(dirProtocolos)
    files = d.listFiles();
	files = files.findAll{ it.getName().startsWith(&quot;unidade&quot;) }
	
	q = files.size()
}




Random rand = new Random();
File f = files[rand.nextInt(files.size())];


//pega unidade
nome = f.getName()



//log.info(nome)
unidade = nome.substring(7, 12).toInteger()

//define user
int v
user = []
v = (unidade * 20) - 15
user[0] = &quot;usuario&quot; + v.toString().padLeft(5, &quot;0&quot;)
v = (unidade * 20) - 14
user[1] = &quot;usuario&quot; + v.toString().padLeft(5, &quot;0&quot;)
v = (unidade * 20) - 13
user[2] = &quot;usuario&quot; + v.toString().padLeft(5, &quot;0&quot;)
v = (unidade * 20) - 12
user[3] = &quot;usuario&quot; + v.toString().padLeft(5, &quot;0&quot;)


usuario = user.get(rand.nextInt(user.size()))

vars.put(&quot;usuario&quot;, usuario)

id_procedimento = nome.substring(18)

//log.info(id_procedimento)

procedimento_formatado = f.readLines().get(0).replace(&quot;ProcedimentoFormatado=&quot; , &quot;&quot;)           

vars.put(&quot;protocolo_formatado&quot;, procedimento_formatado)

// vamos pegar os docs internos
dis = f.readLines().findAll{ it.startsWith(&quot;DocumentoInterno_&quot;) }

qtdDocs = (dis.size())
vars.put(&quot;pesquisaNaUnidade_qtdDocsInternos&quot;, qtdDocs + &quot;&quot;)

for (j=1;j&lt;=dis.size(); j++){

    doc = dis.get(j-1)
    doc = doc.replace(&quot;DocumentoInterno_&quot; + j + &quot;=&quot;, &quot;&quot;)
    //log.info(doc)
    
    vars.put(&quot;pesquisaNaUnidade_DocumentoInterno_&quot; + j, doc)
    

}


// vamos pegar os docs externos
dex = f.readLines().findAll{ it.startsWith(&quot;DocumentoExterno_&quot;) }

qtdDocs = (dex.size())
vars.put(&quot;pesquisaNaUnidade_qtdDocsExternos&quot;, qtdDocs + &quot;&quot;)

for (j=1;j&lt;=dex.size(); j++){

    doc = dex.get(j-1)
