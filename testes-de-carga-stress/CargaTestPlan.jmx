        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import org.apache.jmeter.services.FileServer; 

String datahoje = new java.text.SimpleDateFormat(&quot;dd-MM-yyyy&quot;).format(new Date())
props.put(&quot;propDataHoje&quot;, datahoje)


qtdUnidades = vars.get(&quot;qtdUnidadesInicial&quot;).toInteger()
qtdUsuarios = qtdUnidades * 20

qtdUsuarios = qtdUsuarios + &quot;&quot;

vars.put(&quot;qtdUsuariosInicial&quot;, qtdUsuarios)


basedir = FileServer.getFileServer().getBaseDir();
def fileContents = new File(basedir + &apos;/assets/cpfs.csv&apos;).getText(&apos;UTF-8&apos;);
def lines = 0 

fileContents.eachLine { line -&gt;
      lines++;
      vars.put(&quot;csvCPFs_&quot; + lines, line);

    }


fileContents = new File(basedir + &apos;/assets/unidades.csv&apos;).getText(&apos;UTF-8&apos;);
lines = 0 

fileContents.eachLine { line -&gt;
      lines++;
      vars.put(&quot;csvUnidades_&quot; + lines, line);

      //log.info(line)
    }


</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import org.apache.jmeter.services.FileServer; 

basedir = FileServer.getFileServer().getBaseDir();


File fullPath = new File(basedir + &quot;/assets/runtimeassets/cadProc&quot;)
if (!fullPath.exists())
    fullPath.mkdirs()

//File fullPath = new File(basedir + &quot;/assets/runtimeassets/pesquisaNaUnidade&quot;)
//if (!fullPath.exists())
//    fullPath.mkdirs()

def directory = new File(basedir + &quot;/assets/runtimeassets/cadProc&quot;)

bolKeepRuntimeAssets = vars.get(&quot;bolKeepRuntimeAssets&quot;)

if(bolKeepRuntimeAssets != &quot;true&quot;){

    for (File f : directory.listFiles()) {
        //log.info(f.getName())
        if (f.getName().startsWith(&quot;unidade&quot;)) {
            f.delete(); // may fail mysteriously - returns boolean you may want to check
        }
    }

}
</stringProp>
        </JSR223Sampler>
